# Формат документации: md или html
DOC_FORMAT=md

# ClickHouse
CLICKHOUSE_PORT=<порт>
CLICKHOUSE_HOST=<хост>
CLICKHOUSE_USER=<пользователь>
CLICKHOUSE_PASSWORD=<пароль>
CLICKHOUSE_DATABASE=<база данных>

# Каталог для результата
DOC_OUTPUT_DIR=docs

# Ccылка на интерактивную ER-диаграмму (GitLab Pages) в документации.
ER_PAGES_URL=<ссылка на интерактивную ER-диаграмму>

# Ссылка на faq
ER_FAQ_URL=<ссылка на faq>