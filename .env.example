# Формат документации: md или html
DOC_FORMAT=md

# ClickHouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_HOST=localhost
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=123456
CLICKHOUSE_DATABASE=test_db

# Каталог для результата
DOC_OUTPUT_DIR=docs

# Ссылка на интерактивную ER-диаграмму (GitLab Pages) в документации.
# Пример: https://username.gitlab.io/repository/
# Если пусто — используется относительный путь er_diagram.html
ER_PAGES_URL=
